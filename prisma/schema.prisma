generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  TRAINER
  ANALYST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ServiceStatus {
  PUBLISHED
  DRAFT
  ARCHIVED
}

enum ContentStatus {
  PUBLISHED
  DRAFT
}

enum TrainingStatus {
  OPEN
  FULL
  DRAFT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  role         UserRole   @default(EDITOR)
  status       UserStatus @default(PENDING)
  lastActiveAt DateTime?  @map("last_active_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Service {
  id          String        @id
  title       String
  description String        @db.Text
  note        String        @db.Text
  items       String[]
  amountNgn   Int?          @map("amount_ngn")
  duration    String?
  imageUrl    String?       @map("image_url")
  sortOrder   Int           @default(0) @map("sort_order")
  status      ServiceStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([sortOrder])
  @@map("services")
}

model ContentSection {
  id        String        @id
  title     String
  section   String
  status    ContentStatus @default(PUBLISHED)
  data      Json
  sortOrder Int           @default(0) @map("sort_order")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([sortOrder])
  @@map("content_sections")
}

model TrainingProgram {
  id        String         @id
  title     String
  cohort    String
  enrolled  Int            @default(0)
  capacity  Int
  startDate DateTime       @map("start_date")
  status    TrainingStatus @default(DRAFT)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@index([status])
  @@index([startDate])
  @@index([sortOrder])
  @@map("training_programs")
}
